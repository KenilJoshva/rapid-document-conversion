# Rapid Document Conversion - Non-Secret Configuration
# Copy to .env for local overrides. Never commit actual AWS credentials or secrets.

# AWS Region & Stack Name
AWS_REGION=us-east-1
STACK_NAME=rapid-document-conversion

# Storage Configuration
# Set to 'local' for offline development without AWS credentials; 's3' when connected to an Amazon S3 bucket
STORAGE_BACKEND=local
DOC_BUCKET_NAME=rapid-doc-conversion-storage-local

# Service Limits
MAX_FILE_SIZE_MB=10

# Security & CORS
CORS_ALLOW_ORIGIN=*
